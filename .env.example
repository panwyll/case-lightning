# ── Marketing site (existing) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_GA_ID=

# ── Product backend ──────────────────────────────────────────────────────────
# App origin (Vercel domain in prod; https://localhost:3000 for local sideload)
APP_URL=https://localhost:3000

# Postgres (Supabase pooler / direct connection string). Needed for all product
# features and for `npm run migrate`. Enable the `vector` + `pgcrypto` extensions.
DATABASE_URL=

# Session cookie signing + at-rest encryption of per-user BYOK keys (long random)
SESSION_JWT_SECRET=
APP_ENCRYPTION_KEY=

# Microsoft Entra (Azure AD) app registration — single tenant recommended.
# Redirect URI: ${APP_URL}/api/v1/auth/callback
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://localhost:3000/api/v1/auth/callback
GRAPH_SCOPES=User.Read Mail.Read Mail.ReadWrite MailboxSettings.ReadWrite Files.ReadWrite Sites.ReadWrite.All Team.ReadBasic.All ChannelMessage.Send

# AI — Claude for generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Embeddings (optional — RAG degrades gracefully without it). voyage | openai
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
EMBEDDING_DIM=1024
# OPENAI_API_KEY=        # only if EMBEDDINGS_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# OneDrive root folder for per-case knowledge bases
ONEDRIVE_ROOT=CaseLightning

# Protects the subscription-renewal + referral-apply crons (Vercel Cron sends it as a Bearer token).
# Auto-triage subscriptions need a public HTTPS APP_URL — they don't work on localhost.
CRON_SECRET=

# Conveyancing engine (lib/server/engine). The timer sweep /api/v1/cron/engine-tick uses
# CRON_SECRET above. The InfoTrack webhook STUB at /api/v1/integrations/infotrack/webhook
# is disabled (503) until this is set; the real integration will replace it.
INFOTRACK_WEBHOOK_SECRET=
# InfoTrack API (component #4). Providers stay mocked until all three are set.
INFOTRACK_BASE_URL=
INFOTRACK_CLIENT_ID=
INFOTRACK_CLIENT_SECRET=
# INFOTRACK_TOKEN_URL=            # only if the token endpoint is off-host

# Engine models (component #2/#3). Default claude-opus-5; ENGINE_EXTRACTOR / ENGINE_AI = auto|claude|fixture/template.
# ENGINE_EXTRACT_MODEL=claude-opus-5
# ENGINE_DRAFT_MODEL=claude-opus-5
# ENGINE_QA_MODEL=claude-opus-5

# Client comms (component #5). WhatsApp via the Meta Cloud API; email via Resend (see RESEND_* below).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Third-party chases: draft (Outlook draft + worklist item, default) | send (auto-send from the fee-earner's mailbox)
ENGINE_CHASE_MODE=draft

# Owner-only internal analytics dashboard at /internal (global cross-tenant metrics:
# funnel, economics, churn, usage). Set any strong secret; you enter it once in the
# dashboard. Unset = dashboard locked. NOT tied to the Outlook/Entra login.
INTERNAL_DASHBOARD_KEY=

# ── Billing + referrals (Stripe) ─────────────────────────────────────────────
# The existing NEXT_PUBLIC_STRIPE_PAYMENT_LINK drives /start-trial. These power
# the webhook-driven referral commission ledger (£50/mo account credit per referral).
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/v1/billing/webhook (Stripe Dashboard → Webhooks).
# Subscribe to: checkout.session.completed, invoice.paid, invoice.payment_failed,
# invoice.voided, charge.refunded, customer.subscription.{created,updated,deleted}.
STRIPE_WEBHOOK_SECRET=
REFERRAL_COMMISSION_PENNIES=5000
BILLING_CURRENCY=gbp

# Optional: restrict draft recipients to these domains (comma separated)
ALLOWED_EXTERNAL_DOMAINS=
