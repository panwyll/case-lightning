# Copy to .env.local for development. Set the same keys in your host for production.
# In production the app refuses to start without the four secrets below.

# --- Secrets -----------------------------------------------------------------

# Signs every session cookie. Rotating it signs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

# Derives each guest's personal access code. Rotating it invalidates every
# personal link that has already been sent, so change it before you send them,
# not after.
#   openssl rand -base64 32
GUEST_LINK_SECRET=

# The shared password printed on the invitations.
SITE_PASSWORD=

# Your way into /admin. Make this a different, longer one.
ADMIN_PASSWORD=

# --- Storage -----------------------------------------------------------------

# Unset: RSVPs and visits go to .data/store.json — fine locally, useless on
# Vercel, where the filesystem is per-instance and thrown away.
# Set: Postgres. Run `npm run migrate` once, then deploy.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# --- Links -------------------------------------------------------------------

# Used when printing personal links. On Vercel this is inferred from
# VERCEL_PROJECT_PRODUCTION_URL, so it is only needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://alex-and-sam.example.com
