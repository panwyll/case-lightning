{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/v1/graph/subscriptions/renew",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/referrals/apply",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/v1/onboarding/resume",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/v1/cron/engine-tick",
      "schedule": "30 6-17 * * 1-5"
    },
    {
      "path": "/api/v1/cron/intouch-sync",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/v1/cron/send-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/notify",
      "schedule": "*/30 7-18 * * 1-5"
    },
    {
      "path": "/api/v1/cron/leap-sync",
      "schedule": "15 * * * *"
    }
  ]
}
